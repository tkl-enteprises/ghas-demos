# Copy this file to `.env` and fill in real values for local development.
# ⚠️ Never commit `.env` (it should already be in your top-level .gitignore).
#
# This file is the "right" pattern that this lesson teaches:
#   - Variable names checked into source control.
#   - Values left empty — filled in locally per developer / per environment.
#   - Production reads the same names from a real secrets manager.
#
# Because there are no values here, secret scanning has nothing to flag.

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_REGION=westeurope

STRIPE_API_KEY=

